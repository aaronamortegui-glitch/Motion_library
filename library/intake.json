{
  "version": "2026-10-22",
  "note": "How the Agent reads a request (read_brief, tools/intake.py). Each entry is something Claude can propose: a code-rendered template, a technique, a style, a character or a kit family, with the words that point to it (English and Spanish, accents ignored), what kind of video it serves (domain), what is on screen, what it needs from the user, and its energy range. Questions are asked only for what the request leaves open. Add an entry with every new template, technique, style or character (CONTRIBUTING §11).",
  "questions": {
    "purpose":  { "ask": "What is it for, and where will it run?", "options": ["Social (9:16 reel / story)", "Web or landing (16:9)", "Presentation or event", "Ad or product launch", "Tutorial or internal"],
                  "found": ["reel", "story", "stories", "tiktok", "instagram", "linkedin", "youtube", "landing", "web", "website", "presentation", "presentacion", "keynote", "evento", "event", "ad", "anuncio", "launch", "lanzamiento", "tutorial", "onboarding", "9:16", "16:9", "1:1", "4:5", "vertical", "horizontal", "social", "redes"] },
    "length":   { "ask": "How long should it be?", "options": ["About 6 s", "15 s", "30 s", "60 s or more"],
                  "found_regex": "\\b\\d+(\\.\\d+)?\\s*(s|sec|secs|seconds|seg|segundos|segs|min|minutes|minutos)\\b" },
    "assets":   { "ask": "What do you already have?", "multi": true, "options": ["Logo", "Screenshots or product shots", "Footage (people or product)", "Voiceover or script", "Music", "A character", "Nothing yet: generate what is missing (I quote first)"],
                  "found": ["logo", "screenshot", "screenshots", "captura", "capturas", "footage", "clip", "clips", "video de", "grabacion", "voz", "voiceover", "voice", "guion", "script", "musica", "music", "cancion", "song", "personaje", "character", "mascota", "mascot", "foto", "fotos", "photos", "figma"] },
    "energy":   { "ask": "What feel? (1 calm … 5 explosive)", "options": ["1-2 calm, premium", "3 clear, modern", "4 dynamic, punchy", "5 explosive, social"],
                  "found": ["calm", "calmado", "tranquilo", "suave", "soft", "premium", "elegant", "elegante", "minimal", "minimalista", "dynamic", "dinamico", "energetic", "energetico", "punchy", "explosive", "explosivo", "fun", "divertido", "playful", "jugueton", "serio", "serious", "corporate", "corporativo", "epic", "epico"] },
    "message":  { "ask": "What is the one thing it must say (title or line)?", "options": [],
                  "found_regex": "[\"'“”«»]" }
  },
