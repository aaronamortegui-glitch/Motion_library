    "out": {
     "influence": 75,
     "speed_x_avg": 0
    },
    "in": {
     "influence": 95,
     "speed_x_avg": 0
    }
   }
  }
 ],
 "ae_conversion": "out.influence = x1*100; out.speed = (y1/x1)*avg; in.influence = (1-x2)*100; in.speed = ((1-y2)/(1-x2))*avg",
