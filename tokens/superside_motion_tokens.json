   "ae": {
    "out": {
     "influence": 87,
     "speed_x_avg": 0
    },
    "in": {
     "influence": 87,
     "speed_x_avg": 0
    }
   }
  },
  {
   "name": "Surge",
   "bezier": [
    0.7,
