    "out": {
     "influence": 50,
     "speed_x_avg": 0
    },
    "in": {
     "influence": 85,
     "speed_x_avg": 0
    }
   }
  },
  {
   "name": "Pop",
   "bezier": [
    0.34,
    1.45,
    0.64,
    1
   ],
   "use": "Entrances with overshoot/bounce for dynamic pieces",
   "ae": {
    "note": "3 keys: 0 → 105% → 100% (Land up to the peak at 60%, Settle back)"
   },
   "overshoot": 0.05
  },
  {
   "name": "Recoil",
   "bezier": [
    0.6,
    0,
    0.75,
    -0.4
   ],
   "use": "Exits with anticipation: pulls back slightly, then leaves (dynamic pieces)",
   "ae": {
    "note": "Undershoot: 3 keys (100% → -4% of the travel → target) or an expression; does not fit in 2 AE keys"
   }
  },
  {
   "name": "Ramp",
   "bezier": [
    0.87,
    0,
    0.13,
    1
   ],
