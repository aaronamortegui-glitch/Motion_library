{
 "version": "0.2-draft",
 "fps": 30,
 "notes": "Superside's own motion tokens. v0.2 calibrated against 6 real transitions sampled in AE (research/calibration_fit.json): entrances 12-17f, typical overshoot ~5%, exits with anticipation.",
 "durations": [
  {
   "name": "Tick",
   "frames": 4,
   "ms": 133,
   "use": "Micro-interactions: clicks, hovers, toggles"
  },
  {
   "name": "Blink",
   "frames": 6,
   "ms": 200,
   "use": "Opacity fades in/out"
  },
  {
   "name": "Glide",
   "frames": 9,
   "ms": 300,
   "use": "Short, efficient element moves"
  },
  {
   "name": "Arrive",
   "frames": 14,
   "ms": 467,
   "use": "Element entrances, elements in motion"
  },
  {
   "name": "Sweep",
   "frames": 21,
   "ms": 700,
   "use": "Changes covering half the screen or more"
  },
  {
   "name": "Stage",
   "frames": 33,
   "ms": 1100,
   "use": "Full-screen moments, scrims, transitions"
  }
 ],
 "easings": [
