   "ae": {
    "out": "linear",
    "in": "linear"
   }
  },
  {
   "name": "Land",
   "bezier": [
    0.12,
    0.9,
    0.28,
    1
   ],
   "use": "Entrances from off-screen (long, softer brake)",
   "ae": {
    "out": {
     "influence": 12,
     "speed_x_avg": 7.5
    },
    "in": {
     "influence": 72,
     "speed_x_avg": 0
    }
   }
  },
  {
   "name": "Launch",
