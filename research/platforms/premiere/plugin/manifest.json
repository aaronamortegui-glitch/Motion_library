{
  "manifestVersion": 5,
  "id": "com.motiondna.premiere",
  "name": "Motion DNA",
  "version": "0.1.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mdna",
      "label": {
        "default": "Motion DNA"
      },
      "minimumSize": {
        "width": 220,
        "height": 120
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 220
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 220
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": true
  }
}
